# ───────────────────────────────────────────────────────────────────────────
# Carousel Forge — example environment
#
# Copy this file to .env.local and fill in only what you need. The defaults
# below run the app in demo mode (no API keys required) so you can boot the
# UI immediately after cloning. Swap demo for a real provider when you want
# live generation.
# ───────────────────────────────────────────────────────────────────────────

# Provider selection ────────────────────────────────────────────────────────
# LLM_PROVIDER controls the model used to structure your script into slides.
# Supported values: demo | azure-openai | openai | anthropic
LLM_PROVIDER=demo

# IMAGE_PROVIDER controls slide background generation.
# Supported values: demo | azure-foundry | openai
IMAGE_PROVIDER=demo

# Azure OpenAI (LLM_PROVIDER=azure-openai) ─────────────────────────────────
# Endpoint is the base URL from the Azure portal — the SDK builds the rest.
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# OpenAI (LLM_PROVIDER=openai or IMAGE_PROVIDER=openai) ────────────────────
OPENAI_API_KEY=
# Optional — override the default model.
OPENAI_MODEL=gpt-4o

# Anthropic (LLM_PROVIDER=anthropic) ───────────────────────────────────────
ANTHROPIC_API_KEY=
# Optional — override the default model.
ANTHROPIC_MODEL=claude-sonnet-4-6

# Azure AI Foundry / FLUX (IMAGE_PROVIDER=azure-foundry) ───────────────────
AZURE_FOUNDRY_KEY=
AZURE_FOUNDRY_ENDPOINT=

# Optional HTTP basic auth ─────────────────────────────────────────────────
# Set both to require credentials on every request. Leave either blank to
# disable. Useful when sharing a private preview deploy.
AUTH_USER=
AUTH_PASS=
